{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"inlineSourceMap": false,
		"moduleResolution": "Node16",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"useDefineForClassFields": false,
		"types": ["node"],
		"noEmit": true,
		"paths": {
			"@ichigo.moe/ave": ["./src/index.ts"],
			"@ichigo.moe/ave/ai": ["./src/ai/index.ts"],
			"@ichigo.moe/ave/ai/*": ["./src/ai/*.ts"],
			"@ichigo.moe/ave/agent": ["./src/agent/index.ts"],
			"@ichigo.moe/ave/tui": ["./src/tui/index.ts"],
			"typebox": ["./node_modules/typebox"]
		}
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts"],
	"exclude": ["node_modules", "dist", "examples/extensions/sandbox"]
}

{
	"name": "@ichigo.moe/ave",
	"version": "0.81.0",
	"description": "ave: a fork of pi-coding-agent (coding agent CLI with read/bash/edit/write tools and session management)",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"bin": {
		"ave": "dist/bin/ave.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./hooks": {
			"types": "./dist/core/hooks/index.d.ts",
			"import": "./dist/core/hooks/index.js"
		},
		"./ai": {
			"types": "./dist/ai/index.d.ts",
			"import": "./dist/ai/index.js"
		},
		"./ai/oauth": {
			"types": "./dist/ai/oauth.d.ts",
			"import": "./dist/ai/oauth.js"
		},
		"./ai/bedrock-provider": {
			"types": "./dist/ai/bedrock-provider.d.ts",
			"import": "./dist/ai/bedrock-provider.js"
		},
		"./agent": {
			"types": "./dist/agent/index.d.ts",
			"import": "./dist/agent/index.js"
		},
		"./tui": {
			"types": "./dist/tui/index.d.ts",
			"import": "./dist/tui/index.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"generate-models": "npx tsx scripts/generate-models.ts",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "npm run generate-models && tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js && npm run copy-assets && npm run bundle-cli",
		"bundle-cli": "npx tsx scripts/bundle-cli.ts",
		"copy-assets": "shx mkdir -p dist/modes/interactive/theme && shx cp src/modes/interactive/theme/*.json dist/modes/interactive/theme/ && shx mkdir -p dist/modes/interactive/assets && shx cp src/modes/interactive/assets/*.png dist/modes/interactive/assets/ && shx mkdir -p dist/core/export-html/vendor && shx cp src/core/export-html/template.html src/core/export-html/template.css src/core/export-html/template.js dist/core/export-html/ && shx cp src/core/export-html/vendor/*.js dist/core/export-html/vendor/ && shx cp src/core/tools/.hash_anchors dist/core/tools/.hash_anchors",
		"test": "vitest --run",
		"check": "biome check --write --error-on-warnings . && tsgo --noEmit",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.90.0",
		"@aws-sdk/client-bedrock-runtime": "^3.1030.0",
		"@google/genai": "^1.40.0",
		"@mariozechner/jiti": "^2.6.2",
		"@mistralai/mistralai": "^2.2.0",
		"@silvia-odwyer/photon-node": "^0.3.4",
		"chalk": "^5.5.0",
		"cli-highlight": "^2.1.11",
		"diff": "^8.0.2",
		"extract-zip": "^2.0.1",
		"file-type": "^21.1.1",
		"get-east-asian-width": "^1.3.0",
		"glob": "^13.0.1",
		"hosted-git-info": "^9.0.2",
		"ignore": "^7.0.5",
		"marked": "^15.0.12",
		"mime-types": "^3.0.1",
		"minimatch": "^10.2.3",
		"openai": "6.26.0",
		"partial-json": "^0.1.7",
		"proper-lockfile": "^4.1.2",
		"proxy-agent": "^6.5.0",
		"strip-ansi": "^7.1.0",
		"typebox": "^1.1.24",
		"undici": "^7.19.1",
		"uuid": "^14.0.0",
		"yaml": "^2.8.2",
		"zod-to-json-schema": "^3.24.6"
	},
	"optionalDependencies": {
		"@mariozechner/clipboard": "^0.3.3",
		"koffi": "^2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/diff": "^7.0.2",
		"@types/hosted-git-info": "^3.0.5",
		"@types/mime-types": "^2.1.4",
		"@types/ms": "^2.1.0",
		"@types/node": "^24.3.0",
		"@types/proper-lockfile": "^4.1.4",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"@xterm/headless": "^5.5.0",
		"@xterm/xterm": "^5.5.0",
		"canvas": "^3.2.0",
		"esbuild": "^0.27.7",
		"shx": "^0.4.0",
		"tsx": "^4.20.3",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "ichigo-Labs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ichigo-Labs/ave.git"
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
